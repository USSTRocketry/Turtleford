{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library-json.json",
  "name": "Turtleford",
  "version": "0.1.0",
  "description": "Avionics connectivity library implementing higher-level communication protocols over LoRa with protobuf encoding",
  "keywords": [
    "avionics",
    "lora",
    "protobuf",
    "communication"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UofS-Rocketry/Turtleford.git"
  },
  "build": {
    "srcDir": "Src",
    "includeDir": "Include",
    "flags": [
      "-std=gnu++20",
      "-D PB_BUFFER_ONLY"
    ]
  },
  "dependencies": [
    {
      "owner": "nanopb",
      "name": "Nanopb",
      "version": "https://github.com/nanopb/nanopb.git#7e19a0db72"
    },
    {
      "name": "HAL",
      "version": "https://github.com/USSTRocketry/HAL.git"
    },
    {
      "name": "Bricks",
      "version": "https://github.com/USSTRocketry/Bricks.git"
    },
    {
      "name": "Tisdale-proto-files",
      "version": "https://github.com/USSTRocketry/Tisdale-proto-files.git"
    }
  ],
  "export": {
    "include": [
      "Include/*",
      "Src/*",
      "library.json"
    ],
    "exclude": [
      "Test/*",
      "build/*",
      "build.py",
      ".git"
    ]
  }
}
